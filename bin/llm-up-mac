#!/usr/bin/env bash
set -euo pipefail

# macOS-friendly bring-up that starts core and commonly used services first.
# It intentionally skips OpenHands/STT/TTS/OCR job services to avoid registry/tooling blockers.

repo_root=$(git rev-parse --show-toplevel)

compose_files=(
  "${repo_root}/compose/docker-compose.yml"
  "${repo_root}/compose/ollama/docker-compose.yml"
  "${repo_root}/compose/open-webui/docker-compose.yml"
  "${repo_root}/compose/qdrant/docker-compose.yml"
  "${repo_root}/compose/postgres/docker-compose.yml"
  "${repo_root}/compose/redis/docker-compose.yml"
  "${repo_root}/compose/redisinsight/docker-compose.yml"
  "${repo_root}/compose/macos/data-services.yml"
  "${repo_root}/compose/reverse-proxy/docker-compose.yml"
  "${repo_root}/compose/macos/docker-compose.yml"
  "${repo_root}/compose/monitoring/docker-compose.yml"
  "${repo_root}/compose/flowise/docker-compose.yml"
  "${repo_root}/compose/forgejo/docker-compose.yml"
  "${repo_root}/compose/openhands/docker-compose.yml"
  "${repo_root}/compose/auth/docker-compose.yml"
  "${repo_root}/compose/node-red/docker-compose.yml"
  "${repo_root}/compose/landing/docker-compose.yml"
  "${repo_root}/compose/pgadmin/docker-compose.yml"
)

args=()
for file in "${compose_files[@]}"; do
  args+=("-f" "$file")
done

env_file="${repo_root}/.env.mac"
if [[ ! -f "$env_file" ]]; then
  env_file="${repo_root}/.env"
fi

if [[ ! -f "$env_file" ]]; then
  echo "ERROR: no env file found (.env.mac or .env)" >&2
  exit 1
fi

docker compose --project-name llm-stack --env-file "$env_file" "${args[@]}" up -d --scale openhands=0

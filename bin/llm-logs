#!/usr/bin/env bash

############################################
# SECTION: File Overview
#
# What this part of the program does:
# Implements an automation/helper script used by the LLMStack tooling layer.
# This script performs a focused operational task in a repeatable way.
#
# Why it exists:
# Automating this workflow reduces manual commands, avoids common mistakes,
# and keeps stack operations consistent for beginner users.
#
# What happens next:
# The script below parses context/inputs, runs the operational steps,
# and reports success or failure to the caller.
############################################

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
since="${SINCE:-30m}"

compose_files=(
  "${repo_root}/compose/docker-compose.yml"
  "${repo_root}/compose/lab/ollama/docker-compose.yml"
  "${repo_root}/compose/core/open-webui/docker-compose.yml"
  "${repo_root}/compose/data/qdrant/docker-compose.yml"
  "${repo_root}/compose/data/postgres/docker-compose.yml"
  "${repo_root}/compose/data/redis/docker-compose.yml"
  "${repo_root}/compose/admin/redisinsight/docker-compose.yml"
  "${repo_root}/compose/lab/macos/data-services.yml"
  "${repo_root}/compose/core/reverse-proxy/docker-compose.yml"
  "${repo_root}/compose/lab/macos/docker-compose.yml"
  "${repo_root}/compose/observability/monitoring/docker-compose.yml"
  "${repo_root}/compose/core/flowise/docker-compose.yml"
  "${repo_root}/compose/admin/forgejo/docker-compose.yml"
  "${repo_root}/compose/lab/openhands/docker-compose.yml"
  "${repo_root}/compose/core/auth/docker-compose.yml"
  "${repo_root}/compose/lab/node-red/docker-compose.yml"
  "${repo_root}/compose/core/landing/docker-compose.yml"
  "${repo_root}/compose/lab/stt/docker-compose.yml"
  "${repo_root}/compose/lab/tts/docker-compose.yml"
  "${repo_root}/compose/lab/ocr/docker-compose.yml"
  "${repo_root}/compose/lab/pdf-ingest/docker-compose.yml"
  "${repo_root}/compose/lab/rag-pipeline/docker-compose.yml"
  "${repo_root}/compose/admin/pgadmin/docker-compose.yml"
)

args=()
for file in "${compose_files[@]}"; do
  args+=("-f" "$file")
done

env_file_arg=()
if [[ -f "${repo_root}/.env.mac" ]]; then
  env_file_arg=(--env-file "${repo_root}/.env.mac")
elif [[ -f "${repo_root}/.env" ]]; then
  env_file_arg=(--env-file "${repo_root}/.env")
fi

if [[ "$#" -eq 0 ]]; then
  echo "Usage: bin/llm-logs <service...>"
  echo "Example: bin/llm-logs reverse-proxy auth open-webui"
  echo "Optional: SINCE=2h bin/llm-logs flowise"
  exit 1
fi

docker compose --project-name llm-stack "${env_file_arg[@]}" "${args[@]}" logs --since "$since" -f "$@"

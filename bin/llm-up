#!/usr/bin/env bash

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)

usage() {
  cat <<USAGE
Usage: ./bin/llm-up [mode]

Modes:
  full            Start all layers (default)
  core            Start data + core
  observability   Start observability layer
  admin           Start admin layer
  lab             Start lab layer
USAGE
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

should_manage_host_ollama() {
  if [[ "$(uname -s)" != "Darwin" ]]; then
    return 1
  fi

  if [[ "${LLMSTACK_MANAGE_HOST_OLLAMA:-1}" == "0" ]]; then
    return 1
  fi

  if ! command -v ollama >/dev/null 2>&1; then
    return 1
  fi

  return 0
}

start_host_ollama() {
  local brew_formula=""

  if command -v brew >/dev/null 2>&1; then
    brew_formula="$(brew list --formula 2>/dev/null | grep -E '^ollama(@[0-9.]+)?$' | head -n1 || true)"
  fi

  if [[ -n "${brew_formula}" ]]; then
    echo "Starting host Ollama with brew services (${brew_formula})..."
    brew services start "${brew_formula}" >/dev/null
    return 0
  fi

  if pgrep -f '[o]llama serve' >/dev/null 2>&1; then
    echo "Host Ollama already running."
    return 0
  fi

  echo "Starting host Ollama via 'ollama serve' fallback..."
  nohup ollama serve >/tmp/llmstack-ollama-serve.log 2>&1 &
}

mode="${1:-full}"

if should_manage_host_ollama; then
  start_host_ollama
fi

case "${mode}" in
  full)
    "${repo_root}/scripts/llm-up-full.sh"
    ;;
  core)
    "${repo_root}/scripts/llm-up-core.sh"
    ;;
  observability)
    "${repo_root}/scripts/llm-up-observability.sh"
    ;;
  admin)
    "${repo_root}/scripts/llm-up-admin.sh"
    ;;
  lab)
    "${repo_root}/scripts/llm-up-lab.sh"
    ;;
  *)
    usage
    exit 1
    ;;
esac

if [[ -x "${repo_root}/bin/pgadmin-sync-sso-users" ]]; then
  "${repo_root}/bin/pgadmin-sync-sso-users" || true
fi

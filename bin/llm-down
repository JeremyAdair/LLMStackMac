#!/usr/bin/env bash

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)

mode="${1:-all}"
if [[ "${mode}" == "--remove" ]]; then
  mode="all"
fi

should_manage_host_ollama() {
  if [[ "$(uname -s)" != "Darwin" ]]; then
    return 1
  fi

  if [[ "${LLMSTACK_MANAGE_HOST_OLLAMA:-1}" == "0" ]]; then
    return 1
  fi

  if ! command -v ollama >/dev/null 2>&1; then
    return 1
  fi

  return 0
}

stop_host_ollama() {
  local brew_formula=""

  if command -v brew >/dev/null 2>&1; then
    brew_formula="$(brew list --formula 2>/dev/null | grep -E '^ollama(@[0-9.]+)?$' | head -n1 || true)"
  fi

  if [[ -n "${brew_formula}" ]]; then
    echo "Stopping host Ollama brew service (${brew_formula})..."
    brew services stop "${brew_formula}" >/dev/null || true
    return 0
  fi

  if pgrep -f '[o]llama serve' >/dev/null 2>&1; then
    echo "Stopping host Ollama process..."
    pkill -f '[o]llama serve' || true
  fi
}

case "${mode}" in
  all|full)
    "${repo_root}/scripts/llm-down-all.sh"
    ;;
  core)
    "${repo_root}/scripts/llm-down-core.sh"
    ;;
  *)
    echo "Usage: ./bin/llm-down [all|core]"
    exit 1
    ;;
esac

if should_manage_host_ollama; then
  stop_host_ollama
fi

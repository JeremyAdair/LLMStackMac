#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)
container="${POSTGRES_CONTAINER:-llm-stack-postgres-1}"

env_file=""
if [[ -n "${LLMSTACK_ENV_FILE:-}" && -f "${LLMSTACK_ENV_FILE}" ]]; then
  env_file="${LLMSTACK_ENV_FILE}"
elif [[ -f "${repo_root}/.env.mac" ]]; then
  env_file="${repo_root}/.env.mac"
elif [[ -f "${repo_root}/.env" ]]; then
  env_file="${repo_root}/.env"
else
  echo "No env file found (.env.mac or .env)." >&2
  exit 1
fi

get_env() {
  local key="$1"
  grep -E "^${key}=" "$env_file" | head -n1 | cut -d= -f2-
}

pg_user="$(get_env POSTGRES_USER)"
pg_password="$(get_env POSTGRES_PASSWORD)"
pg_db="$(get_env POSTGRES_DB)"

if [[ -z "$pg_user" || -z "$pg_password" || -z "$pg_db" ]]; then
  echo "Missing POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB in $env_file" >&2
  exit 1
fi

if ! docker ps --format '{{.Names}}' | grep -qx "$container"; then
  echo "Container $container is not running." >&2
  exit 1
fi

psql_exec() {
  local sql="$1"
  docker exec -e PGPASSWORD="$pg_password" "$container" \
    psql -v ON_ERROR_STOP=1 -h 127.0.0.1 -U "$pg_user" -d "$pg_db" -c "$sql"
}

psql_file() {
  local file="$1"
  local name="$2"
  {
    echo "BEGIN;"
    cat "$file"
    echo "INSERT INTO public.schema_migrations(name) VALUES (:'migration_name');"
    echo "COMMIT;"
  } | docker exec -i -e PGPASSWORD="$pg_password" "$container" \
      psql -v ON_ERROR_STOP=1 -v migration_name="$name" -h 127.0.0.1 -U "$pg_user" -d "$pg_db"
}

psql_exec "CREATE TABLE IF NOT EXISTS public.schema_migrations (name text PRIMARY KEY, applied_at timestamptz NOT NULL DEFAULT now());"

applied="$(
  docker exec -e PGPASSWORD="$pg_password" "$container" \
    psql -At -h 127.0.0.1 -U "$pg_user" -d "$pg_db" -c "SELECT name FROM public.schema_migrations ORDER BY name;"
)"

is_applied() {
  local m="$1"
  local a
  while IFS= read -r a; do
    [[ "$a" == "$m" ]] && return 0
  done <<< "$applied"
  return 1
}

shopt -s nullglob
for file in "$repo_root"/db/migrations/*.sql; do
  name="$(basename "$file")"
  if is_applied "$name"; then
    echo "skip  $name"
    continue
  fi
  echo "apply $name"
  psql_file "$file" "$name"
done

echo "Migrations complete."

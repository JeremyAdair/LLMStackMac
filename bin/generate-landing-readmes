#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
script_path="${repo_root}/scripts/generate-landing-readmes.ps1"

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File "$script_path" "$@"
elif command -v powershell >/dev/null 2>&1; then
  exec powershell -NoProfile -ExecutionPolicy Bypass -File "$script_path" "$@"
else
  echo "ERROR: PowerShell not found. Install PowerShell (pwsh) to run $script_path" >&2
  exit 1
fi

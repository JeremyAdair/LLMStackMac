#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)

mkdir -p "${repo_root}/data/pdfs"
mkdir -p "${repo_root}/repos"
mkdir -p "${repo_root}/config/grafana/provisioning"
mkdir -p "${repo_root}/workspace/ingest" "${repo_root}/workspace/processed" "${repo_root}/workspace/indexed"

cat <<EOF
Created macOS local folders:
  - ${repo_root}/data/pdfs
  - ${repo_root}/repos
  - ${repo_root}/config/grafana/provisioning
  - ${repo_root}/workspace/{ingest,processed,indexed}

Next:
1) Create env file:
   cp .env.mac.example .env.mac

2) Add hosts entries:
   ./bin/hosts-entries
   sudo nano /etc/hosts
   sudo dscacheutil -flushcache
   sudo killall -HUP mDNSResponder

3) Bring up core stack:
   ./bin/llm-up
EOF

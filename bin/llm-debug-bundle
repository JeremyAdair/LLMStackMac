#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
out_dir="${repo_root}/debug-bundles/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$out_dir"

compose_files=(
  "${repo_root}/compose/docker-compose.yml"
  "${repo_root}/compose/ollama/docker-compose.yml"
  "${repo_root}/compose/open-webui/docker-compose.yml"
  "${repo_root}/compose/qdrant/docker-compose.yml"
  "${repo_root}/compose/postgres/docker-compose.yml"
  "${repo_root}/compose/redis/docker-compose.yml"
  "${repo_root}/compose/reverse-proxy/docker-compose.yml"
  "${repo_root}/compose/monitoring/docker-compose.yml"
  "${repo_root}/compose/flowise/docker-compose.yml"
  "${repo_root}/compose/forgejo/docker-compose.yml"
  "${repo_root}/compose/openhands/docker-compose.yml"
  "${repo_root}/compose/auth/docker-compose.yml"
  "${repo_root}/compose/node-red/docker-compose.yml"
  "${repo_root}/compose/landing/docker-compose.yml"
  "${repo_root}/compose/stt/docker-compose.yml"
  "${repo_root}/compose/tts/docker-compose.yml"
  "${repo_root}/compose/ocr/docker-compose.yml"
  "${repo_root}/compose/pdf-ingest/docker-compose.yml"
  "${repo_root}/compose/rag-pipeline/docker-compose.yml"
  "${repo_root}/compose/pgadmin/docker-compose.yml"
  "${repo_root}/compose/redisinsight/docker-compose.yml"
)

if [[ -z "${LLMSTACK_HOST_ROOT:-}" ]] && grep -qi microsoft /proc/version 2>/dev/null; then
  export LLMSTACK_HOST_ROOT="/mnt/c/llm-stack"
fi

args=()
for file in "${compose_files[@]}"; do
  args+=("-f" "$file")
done

env_file_arg=()
if [[ -f "${repo_root}/.env.mac" ]]; then
  env_file_arg=(--env-file "${repo_root}/.env.mac")
elif [[ -f "${repo_root}/.env" ]]; then
  env_file_arg=(--env-file "${repo_root}/.env")
fi

echo "Writing debug bundle to: $out_dir"

{
  echo "timestamp=$(date -Iseconds)"
  echo "repo_root=$repo_root"
  echo "cwd=$(pwd)"
  echo "uname=$(uname -a 2>/dev/null || true)"
} > "${out_dir}/meta.txt"

docker version > "${out_dir}/docker-version.txt" 2>&1 || true
docker info > "${out_dir}/docker-info.txt" 2>&1 || true
docker compose --project-name llm-stack "${env_file_arg[@]}" "${args[@]}" config > "${out_dir}/compose-config.yml" 2>&1 || true
docker compose --project-name llm-stack "${env_file_arg[@]}" "${args[@]}" ps > "${out_dir}/compose-ps.txt" 2>&1 || true
docker ps -a > "${out_dir}/docker-ps-a.txt" 2>&1 || true
docker volume ls > "${out_dir}/docker-volume-ls.txt" 2>&1 || true

core_services=(reverse-proxy auth open-webui flowise ollama qdrant postgres redis forgejo grafana prometheus node-red pgadmin redisinsight openhands)
for svc in "${core_services[@]}"; do
  docker compose --project-name llm-stack "${env_file_arg[@]}" "${args[@]}" logs --since 2h "$svc" > "${out_dir}/logs-${svc}.txt" 2>&1 || true
done

echo "Bundle complete: $out_dir"

{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token",
      "token": "llmstack-openclaw-gateway-token"
    },
    "trustedProxies": [
      "172.18.0.0/16",
      "172.19.0.0/16"
    ],
    "controlUi": {
      "allowedOrigins": [
        "https://openclaw.llmstack.lan"
      ]
    }
  },
  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "http://ollama-gateway:11434/v1",
        "apiKey": "ollama-local",

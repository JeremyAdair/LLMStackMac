{
  "uid": "llmstack-host",
  "title": "LLMStack Host Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "timezone": "browser",
  "tags": ["llmstack", "host", "node_exporter"],
  "panels": [
    {"type":"timeseries","title":"CPU Busy %","gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"100 - (avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)","refId":"A"}]},
    {"type":"timeseries","title":"Memory Used %","gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100","refId":"A"}]},
    {"type":"timeseries","title":"Disk Used % (/)","gridPos":{"h":8,"w":12,"x":0,"y":8},"targets":[{"expr":"100 * (1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}))","refId":"A"}]},
    {"type":"timeseries","title":"Load Average (1m)","gridPos":{"h":8,"w":12,"x":12,"y":8},"targets":[{"expr":"node_load1","refId":"A"}]}
  ],
  "templating":{"list":[]},
  "time":{"from":"now-6h","to":"now"}
}

server {
  listen 11434;

  resolver 127.0.0.11 valid=30s ipv6=off;

  client_max_body_size 64m;
  proxy_http_version 1.1;
  proxy_set_header Host host.docker.internal:11434;
  proxy_set_header Connection "";
  proxy_buffering off;
  proxy_read_timeout 600s;
  proxy_send_timeout 600s;

  # Explicitly block model-management and mutating admin routes.
  location ~ ^/api/(pull|push|create|delete|copy|blobs/) {
    return 403;
  }

  # Allow read-only metadata and inference APIs used by stack services.
  location ~ ^/api/(tags|version|ps)$ {
    proxy_pass ${OLLAMA_UPSTREAM_URL};
  }

  location ~ ^/api/(show|generate|chat|embed|embeddings)$ {
    limit_except POST { deny all; }
    proxy_pass ${OLLAMA_UPSTREAM_URL};
  }

  # Allow OpenAI-compatible inference routes for clients that use them.
  location ~ ^/v1/models$ {
    proxy_pass ${OLLAMA_UPSTREAM_URL};
  }

  location ~ ^/v1/(chat/completions|completions|embeddings)$ {
    limit_except POST { deny all; }
    proxy_pass ${OLLAMA_UPSTREAM_URL};
  }

  # Deny any other unexpected API surface.
  location / {
    return 403;
  }
}

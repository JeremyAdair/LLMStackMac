# macOS storage overrides for Docker Desktop (Apple Silicon)
# Copy to .env.mac and pass with: docker compose --env-file .env.mac ...

# Keep service endpoint defaults
OLLAMA_BASE_URL=http://ollama:11434
QDRANT_URL=http://qdrant:6333

# Use named volumes for high-churn service data
OLLAMA_DATA_MOUNT=ollama_data
OPENWEBUI_DATA_MOUNT=openwebui_data
FLOWISE_DATA_MOUNT=flowise_data
FORGEJO_DATA_MOUNT=forgejo_data
PROMETHEUS_DATA_MOUNT=prometheus_data
GRAFANA_DATA_MOUNT=grafana_data
NODERED_DATA_MOUNT=nodered_data
POSTGRES_DATA_MOUNT=postgres_data
QDRANT_DATA_MOUNT=qdrant_data
REDIS_DATA_MOUNT=redis_data
REDISINSIGHT_DATA_MOUNT=redisinsight_data
OPENHANDS_STATE_MOUNT=openhands_data

# Keep editable/config/content paths as binds
PROMETHEUS_CONFIG_MOUNT=./compose/monitoring/prometheus.yml
GRAFANA_PROVISIONING_MOUNT=./config/grafana/provisioning
# Optional: only include ARM-compatible Grafana plugins.
# GRAFANA_INSTALL_PLUGINS=
PDF_DROP_MOUNT=../data/pdfs
OPENHANDS_REPOS_MOUNT=../repos

# Optional: align OpenHands sandbox bind to repo path
OPENHANDS_SANDBOX_VOLUMES=../repos:/workspace:rw

# Forgejo domain defaults (override if using a different local domain)
FORGEJO_DOMAIN=forgejo.llmstack.lan
FORGEJO_ROOT_URL=https://forgejo.llmstack.lan/
FORGEJO_SSH_DOMAIN=forgejo.llmstack.lan

# Auth/reverse-proxy values required by compose auth service
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=change-me-32-plus-chars
AUTHELIA_SESSION_SECRET=change-me-32-plus-chars
AUTHELIA_STORAGE_ENCRYPTION_KEY=change-me-64-hex
AUTH_DOMAIN=llmstack.lan
LANDING_HOSTNAME=llmstack.lan

# Postgres (required)
POSTGRES_USER=llmstack
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=llmstack

# pgAdmin (required)
PGADMIN_DEFAULT_EMAIL=admin@llmstack.localtest.me
PGADMIN_DEFAULT_PASSWORD=change-me-strong-pgadmin-password

# Open WebUI OIDC SSO via Authelia
OPENWEBUI_ENABLE_LOGIN_FORM=false
OPENWEBUI_ENABLE_OAUTH_SIGNUP=true
OPENWEBUI_OAUTH_MERGE_ACCOUNTS_BY_EMAIL=true
OPENWEBUI_WEBUI_URL=https://openwebui.llmstack.lan
OPENWEBUI_OAUTH_CLIENT_ID=open-webui
OPENWEBUI_OAUTH_CLIENT_SECRET=change-me-client-secret
OPENWEBUI_OPENID_PROVIDER_URL=https://llmstack.lan/authelia/.well-known/openid-configuration
OPENWEBUI_OPENID_REDIRECT_URI=https://openwebui.llmstack.lan/oauth/oidc/callback
OPENWEBUI_OAUTH_PROVIDER_NAME=Authelia
OPENWEBUI_OAUTH_SCOPES=openid email profile
OPENWEBUI_OAUTH_CODE_CHALLENGE_METHOD=S256

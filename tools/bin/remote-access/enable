#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "$0")" && pwd)"
repo_root="$(cd "${script_dir}/../../.." && pwd)"
anchor_name="llmstack/tailscale-only"
anchor_file="/etc/pf.anchors/llmstack_tailscale_only"
pf_conf="/etc/pf.conf"
env_file="${LLMSTACK_ENV_FILE:-${repo_root}/.env.mac}"

find_tailscale_ip() {
  if [[ -n "${LLMSTACK_TAILSCALE_IP:-}" ]]; then
    printf '%s\n' "${LLMSTACK_TAILSCALE_IP}"
    return 0
  fi

  if command -v tailscale >/dev/null 2>&1; then
    local ip
    ip="$(tailscale ip -4 2>/dev/null | head -n1 || true)"
    if [[ -n "${ip}" ]]; then
      printf '%s\n' "${ip}"
      return 0
    fi
  fi

  ifconfig | awk '/inet 100\./ {print $2; exit}'
}

ensure_docker_path() {
  if ! command -v docker >/dev/null 2>&1; then
    export PATH="/Applications/Docker.app/Contents/Resources/bin:$PATH"
  fi
}

tailscale_ip="$(find_tailscale_ip)"
if [[ -z "${tailscale_ip}" ]]; then
  echo "Could not determine this Mac's Tailscale IPv4 address." >&2
  exit 1
fi

tmp_rules="$(mktemp)"
trap 'rm -f "${tmp_rules}"' EXIT

cat > "${tmp_rules}" <<EOF
pass quick on lo0 inet proto tcp from any to 127.0.0.1 port {53, 80, 443, 2222, 7682}
pass quick on lo0 inet proto udp from any to 127.0.0.1 port 53
pass in quick inet proto tcp from 100.64.0.0/10 to any port {53, 80, 443, 2222}
pass in quick inet proto udp from 100.64.0.0/10 to any port 53
pass in quick inet proto tcp from 192.168.65.0/24 to any port 7682
block drop in quick inet proto tcp from any to any port {53, 80, 443, 2222, 7682}
block drop in quick inet proto udp from any to any port 53
EOF

sudo sh <<EOF
set -eu
python3 - <<'PY'
from pathlib import Path

path = Path("${pf_conf}")
text = path.read_text()
bad = 'load anchor "llmstack/tailscale-only" from "/etc/pf.anchors/\n  llmstack_tailscale_only"\n'
good = 'load anchor "llmstack/tailscale-only" from "/etc/pf.anchors/llmstack_tailscale_only"\n'
if bad in text:
    text = text.replace(bad, good)
path.write_text(text)
PY
if ! grep -q 'anchor "${anchor_name}"' "${pf_conf}"; then
  printf '\nanchor "%s"\nload anchor "%s" from "%s"\n' "${anchor_name}" "${anchor_name}" "${anchor_file}" >> "${pf_conf}"
fi
install -m 600 "${tmp_rules}" "${anchor_file}"
pfctl -nf "${pf_conf}"
pfctl -f "${pf_conf}"
pfctl -e 2>/dev/null || true
EOF

if [[ ! -f "${env_file}" ]]; then
  echo "Missing env file: ${env_file}" >&2
  exit 1
fi

perl -0pi -e 's/^HOST_BIND_IP=.*/HOST_BIND_IP=0.0.0.0/m or $_ .= "\nHOST_BIND_IP=0.0.0.0\n"; s/^DNS_BIND_IP=.*/DNS_BIND_IP=0.0.0.0/m or $_ .= "DNS_BIND_IP=0.0.0.0\n"' "${env_file}"

ensure_docker_path
docker compose --env-file "${env_file}" -p llm-core -f "${repo_root}/compose/core.yml" up -d reverse-proxy
docker compose --env-file "${env_file}" -p llm-admin -f "${repo_root}/compose/admin.yml" up -d dns-server forgejo
"${script_dir}/split-dns-sync"

echo
echo "Listeners:"
lsof -nP -iTCP:53 -sTCP:LISTEN || true
lsof -nP -iUDP:53 || true
lsof -nP -iTCP:80 -sTCP:LISTEN || true
lsof -nP -iTCP:443 -sTCP:LISTEN || true
lsof -nP -iTCP:2222 -sTCP:LISTEN || true

echo
echo "Hosts block for other Tailscale PCs:"
LLMSTACK_HOSTS_IP="${tailscale_ip}" "${repo_root}/tools/bin/create-host-entries/llm-hosts-update" --print

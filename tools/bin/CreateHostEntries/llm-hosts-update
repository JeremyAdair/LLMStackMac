#!/usr/bin/env bash
set -euo pipefail

domain="${LLMSTACK_DOMAIN:-llmstack.lan}"
ip="${LLMSTACK_HOSTS_IP:-127.0.0.1}"
hosts_file="${LLMSTACK_HOSTS_FILE:-/etc/hosts}"
start_marker="# >>> LLMSTACK HOSTS START >>>"
end_marker="# <<< LLMSTACK HOSTS END <<<"
hostnames=(
  "${domain}"
  "openwebui.${domain}"
  "flowise.${domain}"
  "openhands.${domain}"
  "openclaw.${domain}"
  "grafana.${domain}"
  "prometheus.${domain}"
  "pgadmin.${domain}"
  "redisinsight.${domain}"
  "qdrant.${domain}"
  "nodered.${domain}"
  "forgejo.${domain}"
)

usage() {
  cat <<USAGE
Usage: ./tools/bin/CreateHostEntries/llm-hosts-update [--print|--check|--apply]

Options:
  --print   Print managed LLMStack hosts block (default)
  --check   Check whether host entries exist in hosts file
  --apply   Add/update managed block in hosts file
  -h, --help
USAGE
}

render_block() {
  cat <<EOF
${start_marker}
# Managed by llm-hosts-update
${ip} ${hostnames[*]}
${end_marker}
EOF
}

apply_block() {
  local tmp
  tmp="$(mktemp)"
  local hosts_csv=""
  local h
  for h in "${hostnames[@]}"; do
    if [[ -n "${hosts_csv}" ]]; then
      hosts_csv+=","
    fi
    hosts_csv+="${h}"
  done

  if [[ -f "${hosts_file}" ]]; then
    awk -v s="${start_marker}" -v e="${end_marker}" -v list="${hosts_csv}" '
      BEGIN {
        n = split(list, arr, ",")
        for (i = 1; i <= n; i++) want[arr[i]] = 1
      }
      $0==s {skip=1; next}
      $0==e {skip=0; next}
      skip==0 {
        drop = 0
        for (i = 2; i <= NF; i++) {
          if ($i in want) {
            drop = 1
          }
        }
        if (!drop) {
          print
        }
      }
    ' "${hosts_file}" > "${tmp}"
  fi

  {
    [[ -s "${tmp}" ]] && tail -n 1 "${tmp}" | grep -q '^$' || echo
    render_block
    echo
  } >> "${tmp}"

  if [[ -w "${hosts_file}" ]]; then
    cp "${tmp}" "${hosts_file}"
  else
    echo "Writing ${hosts_file} requires elevated permissions."
    if command -v sudo >/dev/null 2>&1; then
      sudo cp "${tmp}" "${hosts_file}"
    else
      echo "sudo not found; cannot update ${hosts_file}" >&2
      rm -f "${tmp}"
      exit 1
    fi
  fi

  rm -f "${tmp}"
  echo "Updated ${hosts_file} with LLMStack managed entries."
}

check_block() {
  local missing=0
  local h

  if [[ ! -f "${hosts_file}" ]]; then
    echo "ERR hosts file not found: ${hosts_file}" >&2
    return 1
  fi

  for h in "${hostnames[@]}"; do
    if awk -v ip="${ip}" -v host="${h}" '
      $1==ip {
        for (i=2; i<=NF; i++) {
          if ($i == host) {
            found=1
          }
        }
      }
      END { exit(found ? 0 : 1) }
    ' "${hosts_file}"; then
      echo "OK   ${h} -> ${ip}"
    else
      echo "MISS ${h} -> ${ip}"
      missing=$((missing + 1))
    fi
  done

  if [[ "${missing}" -gt 0 ]]; then
    return 1
  fi
}

mode="print"
if [[ $# -gt 0 ]]; then
  case "$1" in
    --print) mode="print" ;;
    --check) mode="check" ;;
    --apply) mode="apply" ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage
      exit 1
      ;;
  esac
fi

if [[ "${mode}" == "apply" ]]; then
  apply_block
elif [[ "${mode}" == "check" ]]; then
  check_block
else
  render_block
fi

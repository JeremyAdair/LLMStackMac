#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "${script_dir}/../../.." && pwd)"

cd "${repo_root}"

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: ${repo_root} is not a git repository." >&2
  exit 1
fi

branch="${1:-$(git branch --show-current)}"

if [[ -z "${branch}" ]]; then
  echo "Error: could not determine the current branch." >&2
  exit 1
fi

for remote in forgejo origin; do
  if ! git remote get-url "${remote}" >/dev/null 2>&1; then
    echo "Error: git remote '${remote}' is not configured." >&2
    exit 1
  fi
done

secret_pattern='(BEGIN (RSA|DSA|EC|OPENSSH|PGP) PRIVATE KEY|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36,}|github_pat_[A-Za-z0-9_]{20,}|AIza[0-9A-Za-z_-]{35}|sk-[A-Za-z0-9]{20,}|-----BEGIN|password[[:space:]]*[:=][[:space:]]*[^[:space:]]+|secret[[:space:]]*[:=][[:space:]]*[^[:space:]]+|token[[:space:]]*[:=][[:space:]]*[^[:space:]]+)'

scan_remote_range() {
  local remote="$1"
  local range=""

  if git show-ref --verify --quiet "refs/remotes/${remote}/${branch}"; then
    range="${remote}/${branch}..${branch}"
  else
    range="${branch}"
  fi

  if git log -p --no-ext-diff --binary "${range}" | rg -n -i "${secret_pattern}" >/dev/null; then
    echo "Error: potential secret material detected in commits queued for '${remote}'." >&2
    echo "Refusing to push '${branch}'. Review the outgoing diff first." >&2
    exit 1
  fi
}

scan_remote_range forgejo
scan_remote_range origin

echo "Pushing '${branch}' to forgejo..."
git push forgejo "${branch}"

echo "Pushing '${branch}' to origin..."
git push origin "${branch}"

echo "Push complete."
